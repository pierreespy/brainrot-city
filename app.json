{
  "expo": {
    "name": "Divine City",
    "slug": "divine-city",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12141c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pierreespy.divinecity"
    },
    "android": {
      "package": "com.pierreespy.divinecity",
      "adaptiveIcon": {
        "backgroundColor": "#12141c"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12141c",
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ]
  }
}
